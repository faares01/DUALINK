{
  "name": "dualink-desktop",
  "version": "0.1.2",
  "private": true,
  "description": "The native Windows and Linux companion for DUALINK.",
  "author": { "name": "FARES ALAMRI — FAA", "email": "hello@faaa.space" },
  "homepage": "https://faaa.space",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "space.faaa.dualink",
    "productName": "DUALINK",
    "files": ["src/**/*", "package.json"],
    "linux": { "target": ["AppImage", "deb", "rpm", "pacman"], "category": "Utility" },
    "win": { "target": ["nsis", "portable"] }
  }
}
